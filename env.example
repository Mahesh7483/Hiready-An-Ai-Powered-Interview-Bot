# HiREady — root configuration template, read by docker-compose only.
#
#   cp env.example .env && docker compose up --build
#
# Compose substitutes these into both services. `JWT_SECRET` is declared with
# ${JWT_SECRET:?...} so the stack refuses to start without it.
#
# Running the two apps directly instead? Use the per-app templates:
#   hiready-backend/env.example   ->  hiready-backend/.env
#   hiready-frontend/env.example  ->  hiready-frontend/.env
#
# `.env` is gitignored; this file is not, and must never contain a real
# credential.

# ─── Required ───────────────────────────────────────────────────────────────

# Minimum 32 characters — the API throws at boot below that, and compose will
# start a container that immediately crash-loops if you set something shorter.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ─── Backend services ───────────────────────────────────────────────────────

# Groq powers resume analysis, the interviewer and code review.
GROQ_API_KEY=

# Deepgram powers live speech-to-text. Server-side only.
DEEPGRAM_API_KEY=

# Verifies Google sign-in tokens.
FIREBASE_PROJECT_ID=

# Optional — see hiready-backend/env.example for what each one does.
# GROQ_MODEL=openai/gpt-oss-120b
# CORS_ORIGINS=http://localhost:3000
# ADMIN_EMAILS=
# ALLOW_UNSAFE_SANDBOX=0

# ─── Frontend build arguments ───────────────────────────────────────────────
#
# Vite inlines these into the public bundle at BUILD time, so compose passes
# them as build args rather than runtime environment. They are public
# identifiers, not secrets. Leave blank for email/password sign-in only.
#
# VITE_API_URL is not listed here: compose sets it to /api, because nginx
# serves the SPA and proxies the API on the same origin.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
