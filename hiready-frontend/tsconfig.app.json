{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting — strict type-safety enforced; unused-vars are lint warnings not type errors */
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitAny": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,

    "paths": {
      "@/*": ["./src/*"],

      // The suites are outside this package, so TypeScript's node_modules
      // walk from their location never reaches ours and `vitest` resolves to
      // nothing. Pinned explicitly rather than left to resolution order.
      "vitest": ["./node_modules/vitest"],

      // The test toolchain, same reason. NOT a "*" catch-all: that makes
      // TypeScript resolve "react" to node_modules/react/index.js and stop
      // looking for @types/react, so the whole app loses its types to
      // implicit any. Tried it; 200 errors. Targeted entries only.
      "@testing-library/*": ["./node_modules/@testing-library/*"],
      "react-router-dom": ["./node_modules/react-router-dom"]
    },

    // Same reason: a file outside rootDir needs somewhere to resolve
    // ambient package types from.
    "typeRoots": ["./node_modules/@types"]
  },
  // The suites live at <repo>/tests/frontend, outside this package. Without
  // them here tsc silently stops checking them — verified by planting a type
  // error in a moved test and watching the build stay green.
  "include": ["src", "../tests/frontend"]
}
