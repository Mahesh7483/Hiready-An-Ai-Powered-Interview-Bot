# HiREady API — configuration template
#
#   cp env.example .env
#
# Then fill in the values below. `.env` is gitignored; this file is not, and
# must never contain a real credential.
#
# Every variable here was derived from `process.env.*` reads in server.js,
# routes/, services/, models/ and middleware/ — not from memory.

# ─── Required. The server refuses to boot without these. ────────────────────

# Signs session tokens. Minimum 32 characters, enforced at boot in server.js.
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# MongoDB connection string. The server throws at boot if this is unset — it
# used to start without a database and fail only when someone tried to use it.
# Local:   mongodb://127.0.0.1:27017/hiready
# Docker:  mongodb://mongo:27017/hiready
MONGO_URI=mongodb://127.0.0.1:27017/hiready

# ─── Needed for the AI features. ────────────────────────────────────────────

# Groq. Without it, resume analysis, the interviewer and code review all
# return 502. https://console.groq.com/keys
GROQ_API_KEY=

# Overrides the default model. The default is openai/gpt-oss-120b, which is
# also the model the evaluation harness in experiments/ measures — change one
# and the paper stops describing what is deployed.
# GROQ_MODEL=openai/gpt-oss-120b

# Deepgram, for live speech-to-text in the voice interview. The browser only
# ever receives 60-second scoped tokens; this key stays server-side.
# https://console.deepgram.com
DEEPGRAM_API_KEY=

# ─── Needed for Google sign-in. ─────────────────────────────────────────────

# Verifies Firebase ID tokens (checked as both issuer and audience). Without
# it every Google sign-in is rejected.
FIREBASE_PROJECT_ID=

# ─── Optional. Sensible defaults if unset. ──────────────────────────────────

# Port the API listens on. Default 5000.
# PORT=5000

# development | production | test. Production refuses unsandboxed code
# execution and disables the localhost CORS allowance.
# NODE_ENV=development

# Comma-separated browser origins allowed to call this API. Defaults to
# localhost:3000, :8080 and :5173. Set this to your real domain in production
# — the localhost allowance is disabled there.
# CORS_ORIGINS=https://hiready.example.com

# Comma-separated addresses eligible for the admin role. NOTE: listing an
# address does not grant anything on its own. Promotion requires a verified
# identity (Google sign-in with email_verified), because signup alone proves
# nothing about who owns an address. Seed the first admin with:
#   node scripts/makeAdmin.js you@example.com
# ADMIN_EMAILS=

# How long a stored webcam frame lives before the TTL index drops it.
# Default 90. This is biometric data — set the SHORTEST period your policy
# and jurisdiction allow, not the longest.
# PROCTOR_SNAPSHOT_RETENTION_DAYS=90

# How long a submission lease is held before it can be reclaimed, in ms.
# Default 60000. Only raise this if submissions legitimately take longer.
# SUBMISSION_LEASE_DURATION_MS=60000

# Set to 1 to allow code execution WITHOUT nsjail in production. Off by
# default and it should stay off: it runs submitted code with no isolation.
# Only meaningful when NODE_ENV=production.
# ALLOW_UNSAFE_SANDBOX=0

# ─── Tooling only. Not read by the running server. ──────────────────────────

# Base URL for scripts/benchmarkEndpoints.js. Default http://localhost:5000
# BENCHMARK_BASE=http://localhost:5000

# Guard model used by the injection experiment in experiments/.
# GROQ_GUARD_MODEL=
